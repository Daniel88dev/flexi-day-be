# syntax=docker/dockerfile:1
# E2E Testing Dockerfile
FROM node:24-alpine
LABEL authors="danielhrynusiw"
# pnpm stays in this image: its command is a package script. Same version as packageManager.
COPY --from=ghcr.io/pnpm/pnpm:12.16.1-alpine@sha256:3b67e34454e18e4797a50ade3176dde31cec13ad6670f460a81bdf6e1d8b547b /opt/pnpm /opt/pnpm
RUN ln -s /opt/pnpm/pnpm /usr/local/bin/pnpm
WORKDIR /app

# Install dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/var/cache/pnpm \
  pnpm install --frozen-lockfile --store-dir /var/cache/pnpm

# Copy source and config files
COPY tsconfig.json ./
COPY drizzle.config.ts ./
COPY vitest.config.ts ./
COPY vitest.e2e.config.ts ./
COPY src ./src

# Build the application
RUN pnpm run build

# Default command runs e2e tests
CMD ["pnpm", "run", "test:e2e"]
