# General Configuration
aws_region   = "eu-central-1"
environment  = "production"
project_name = "flexi-day-be"

# VPC Configuration
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["eu-central-1a", "eu-central-1b"] # RDS requires subnets in at least 2 AZs

# RDS Configuration
db_instance_class          = "db.t3.micro" # Upgrade to db.t3.small+ if the app grows
db_allocated_storage       = 20
db_name                    = "flexiday"
db_username                = "postgres"
db_port                    = 5432
db_backup_retention_period = 7
db_multi_az                = false # true doubles RDS cost; enable when uptime matters

# ECR Configuration (existing repository, images pushed by GitHub Actions)
ecr_repository_name = "daniel88dev/flexi-day-be"
docker_image_tag    = "main" # App Runner auto-deploys every push to this tag

# App Runner Configuration
app_port           = 8080 # matches Dockerfile EXPOSE/ENV PORT
apprunner_cpu      = "256"
apprunner_memory   = "512"
apprunner_max_size = 2

# Domain Configuration
hosted_zone_name = "flexi-day.com"
api_domain_name  = "api.flexi-day.com"

# STEP 2 OF FIRST ROLLOUT: flip to true after the first successful apply,
# then apply again to create the TLS certificate validation records.
manage_dns_validation_records = false

# CORS / Better Auth trusted origins (your frontend URLs)
trusted_origins = ["https://flexi-day.com", "https://www.flexi-day.com"]

# Better Auth secret: leave empty to auto-generate a random 64-char secret
# (stored only in Secrets Manager + terraform state).
better_auth_secret = ""

# Google OAuth: leave both empty to disable Google sign-in. When set, the
# client id is injected as a plain env var and the client secret is stored in
# Secrets Manager. Register this redirect URI in the Google Cloud console:
#   https://api.flexi-day.com/api/auth/callback/google
# Prefer setting these via env vars (TF_VAR_google_client_secret) rather than
# committing them here.
google_client_id     = ""
google_client_secret = ""

# Paddle billing. Leave paddle_api_key empty to disable billing entirely: no
# Paddle secrets are created, no Paddle env vars are injected, and the
# backend's /api/billing/* routes return 503.
#
# Once paddle_api_key is set, ALL of the following are required — terraform
# fails at plan time otherwise (see the preconditions in secrets.tf), rather
# than letting App Runner boot-loop on a config error.
#
# Sandbox and production are separate Paddle accounts with separate catalogs,
# so production price IDs are NOT the same as your sandbox ones.
paddle_api_key        = ""
paddle_webhook_secret = ""

# "sandbox" or "production". Terraform refuses to combine "sandbox" with
# environment = "production", and the backend enforces the same rule at boot.
paddle_environment = "production"

# All six keys must be present when billing is enabled — this is a typed
# object, so a partial map is a plan error. Price IDs are public identifiers,
# not secrets, and are injected as plain env vars.
paddle_prices = {
  pro_monthly         = ""
  pro_yearly          = ""
  enterprise_monthly  = ""
  enterprise_yearly   = ""
  extra_group_monthly = ""
  extra_group_yearly  = ""
}
