# General Configuration
aws_region   = "eu-central-1"
environment  = "production"
project_name = "flexi-day-be"

# VPC Configuration
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["eu-central-1a", "eu-central-1b"] # RDS requires subnets in at least 2 AZs

# RDS Configuration
db_instance_class          = "db.t3.micro" # Upgrade to db.t3.small+ if the app grows
db_allocated_storage       = 20
db_name                    = "flexiday"
db_username                = "postgres"
db_port                    = 5432
db_backup_retention_period = 7
db_multi_az                = false # true doubles RDS cost; enable when uptime matters

# ECR Configuration (existing repository, images pushed by GitHub Actions)
ecr_repository_name = "daniel88dev/flexi-day-be"
docker_image_tag    = "main" # App Runner auto-deploys every push to this tag

# App Runner Configuration
app_port           = 8080 # matches Dockerfile EXPOSE/ENV PORT
apprunner_cpu      = "256"
apprunner_memory   = "512"
apprunner_max_size = 2

# Domain Configuration
hosted_zone_name = "flexi-day.com"
api_domain_name  = "api.flexi-day.com"

# STEP 2 OF FIRST ROLLOUT: flip to true after the first successful apply,
# then apply again to create the TLS certificate validation records.
manage_dns_validation_records = false

# CORS / Better Auth trusted origins (your frontend URLs)
trusted_origins = ["https://flexi-day.com", "https://www.flexi-day.com"]

# Better Auth secret: leave empty to auto-generate a random 64-char secret
# (stored only in Secrets Manager + terraform state).
better_auth_secret = ""
