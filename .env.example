# Copy to .env and fill in. .env is gitignored.

# --- Core (required; config.ts throws on startup if missing/invalid) ---
NODE_ENV=dev            # production | dev | test
PORT=8080
DATABASE=postgres://localhost:5432/flexi-day
# A lone secret is version 1. Production sets BETTER_AUTH_SECRETS instead:
# `<version>:<secret>` pairs, newest first, e.g. 2:<new>,1:<old>.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# --- Local dev tooling (/api/dev/*) — NEVER set in a deployed environment ---
# Seeds verified users, teams and vacations, and issues session cookies so the
# UI can be driven locally without SES email verification. The server refuses to
# start if this is true with NODE_ENV=production or a non-local DATABASE, and
# every request must come from loopback carrying DEV_TOOLS_TOKEN as x-dev-token.
DEV_TOOLS_ENABLED=false
DEV_TOOLS_TOKEN=            # >= 16 chars; required only when enabled
DEV_SEED_EMAIL_DOMAIN=dev.local   # the only domain seeding may create or reset

# --- Google OAuth (optional) ---
# Redirect URI to register: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft Entra ID OAuth (optional) ---
# Redirect URI to register: {BETTER_AUTH_URL}/api/auth/callback/microsoft
# The provider is registered only when BOTH id and secret are set.
# The app registration MUST request the `email` optional ID-token claim (Entra
# -> Token configuration). Without it a work account with no mailbox yields no
# address at all and the callback fails with error=email_not_found.
#
# No Entra claim marks the address verified here. `xms_edov` and friends attest
# the DOMAIN, not that the person signing in owns the mailbox — a directory
# admin can point a user's mail attribute at any address in a domain they
# administer — so social sign-in always lands unverified and the user confirms
# the address through Flexi Day's own email, same as an email/password signup.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Directory the sign-in is issued against. Default "common" = any work/school
# account plus personal Microsoft accounts. Use "organizations" to exclude
# personal accounts, or a tenant GUID to allow one directory only.
MICROSOFT_TENANT_ID=

# --- Sign in with Apple (optional) ---
# Return URL registered on the Services ID: {BETTER_AUTH_URL}/api/auth/callback/apple
# The provider is registered only when all five values are set; a partial set
# leaves Apple off, as a missing Google or Microsoft secret does.
# Production values (all public except the key): Services ID com.flexiday.web,
# Team ID S6FC47MMXJ, Key ID 337627W447, bundle id com.flexiday.app. The .p8
# key is in 1Password; paste it on one line with literal \n, or double-quoted
# with real newlines. The backend mints the one-hour client secret from it, and
# refuses to start when all five are set but the key does not parse.
# TRUSTED_ORIGINS below must include https://appleid.apple.com: Apple POSTs the
# web callback and better-auth refuses a non-GET from an untrusted origin.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_APP_BUNDLE_IDENTIFIER=com.flexiday.app
APPLE_PRIVATE_KEY=

# --- Push notifications through APNs (optional) ---
# All four or none. With none set, pushes go to a log sender, so a dev machine
# needs no Apple key. Production values (all public except the key): Key ID
# RY2AN56AAC (team-scoped, signs for sandbox and production), Team ID
# S6FC47MMXJ, topic com.flexiday.app. The .p8 is the 1Password Document item
# "Flexi Day APNs key"; paste it the same way as APPLE_PRIVATE_KEY. With all
# four set locally, a phone running a dev client gets real sandbox pushes.
# Tests never use the real sender. Production gets these from Terraform: see
# "Push notifications (APNs)" in docs/terraform.md.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRIVATE_KEY=

# --- Calendar direct sync (optional) ---
# Writes a user's approved absences into their own Google or Microsoft primary
# calendar. Each switch counts only when that provider's sign-in credentials
# above are set, since the connections reuse the same OAuth clients. Register
# these redirect URIs on the same Google client and Entra app:
#   {BETTER_AUTH_URL}/api/calendar-sync/connections/google/callback
#   {BETTER_AUTH_URL}/api/calendar-sync/connections/microsoft/callback
# After the callback the browser returns to APP_URL (below).
# The driver is live (calls the provider APIs) or fake (records writes locally,
# never calls out). The server refuses to start on fake with NODE_ENV=production.
CALENDAR_SYNC_GOOGLE_ENABLED=false
CALENDAR_SYNC_MICROSOFT_ENABLED=false
CALENDAR_SYNC_DRIVER=live

# --- App / URLs ---
APP_URL=http://localhost:3000
APP_VERSION=            # release identifier; also used as Sentry release fallback
SERVICE_NAME=flexi-day-be
FEED_BASE_URL=
# Comma-separated allowed origins; flexiday:// is the phone app's URL scheme and
# https://appleid.apple.com is where Apple's web callback POSTs from.
TRUSTED_ORIGINS=http://localhost:3000,flexiday://,https://appleid.apple.com
LOG_DIR=
# Comma-separated paths whose request/response log lines are skipped entirely
# (matched against the redacted path, so templated routes work too). Deployed
# environments set this to the liveness probes, which would otherwise dominate.
REQUEST_LOG_IGNORE_PATHS=

# --- Year-end quota rollover job ---
# Opens each member's allowance for the current year, carrying their unused
# days forward. Idempotent: it only creates rows that are missing, so it never
# overwrites an admin's edit and is safe to run on a daily schedule. The same
# tick runs the attachment retention sweep, so disabling it stops both.
QUOTA_ROLLOVER_ENABLED=true
QUOTA_ROLLOVER_CRON=0 2 * * *      # daily 02:00; catches up if a 1 Jan run was missed
QUOTA_ROLLOVER_TIMEZONE=Europe/Prague

# --- Attachments ---
# Unset locally: the disk-backed store serves uploads and downloads itself from
# ATTACHMENTS_DIR (default: a gitignored .attachments folder in the repo
# root). With a bucket the S3 store presigns uploads and downloads instead, the
# local routes disappear, and the attachment-processor Lambda (docs/adr/0003)
# reports back through POST /api/attachments/processed, signed with the
# callback secret. The server refuses to start without a bucket when
# NODE_ENV=production, and without the secret whenever a bucket is set.
# Terraform generates the secret and hands it to both sides; under test a
# per-process key stands in so the e2e suite can drive the callback itself.
ATTACHMENTS_BUCKET=
ATTACHMENTS_CALLBACK_SECRET=
ATTACHMENTS_DIR=

# --- Organization data ---
# The bucket for Person exports (exports/, expired after 7 days by a lifecycle
# rule). Unset locally: a disk store under ORGANIZATION_DATA_DIR (default: a
# gitignored .organization-data folder) serves the signed downloads itself.
# Unset in production, export requests answer 503 until Terraform supplies it.
# The KMS key ARN is for field encryption; the bucket's default key covers
# the exports.
ORGANIZATION_DATA_BUCKET=
ORGANIZATION_DATA_KMS_KEY_ARN=
ORGANIZATION_DATA_DIR=

# --- AWS SES / email ---
AWS_REGION=eu-central-1
EMAIL_FROM=
EMAIL_TEMPLATE_STAGE=   # dev | prod (selects flexi-day-email-confirmation-{dev,prod})
SES_CONFIGURATION_SET=

# --- Sentry ---
# DSN is code-defaulted; override only to point at a different project.
SENTRY_DSN=
# Sentry is on in production automatically; set true to enable it elsewhere.
SENTRY_ENABLE=false
SENTRY_DEBUG=false
SENTRY_RELEASE=         # falls back to APP_VERSION
# Fraction of requests traced (0.0-1.0). Default 0.2.
SENTRY_TRACES_SAMPLE_RATE=0.2
# Fraction of sampled traces that are CPU-profiled (0.0-1.0). Default 0.1.
# Profiling is trace-lifecycle-bound and accrues profile-hours quota fast on an
# always-on server, so keep this low. Bump toward 1.0 for targeted debugging.
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1
