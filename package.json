{
  "name": "flexi-day-be",
  "version": "0.1.1",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "dev": "npm run build && node --import ./dist/instrument.js dist/index.js",
    "test": "vitest --run",
    "test:unit": "vitest --run --config vitest.config.ts",
    "test:e2e:check": "tsx src/tests/e2e/check-db.ts",
    "test:e2e": "npm run test:e2e:check && vitest --run --config vitest.e2e.config.ts",
    "test:e2e:watch": "npm run test:e2e:check && vitest --config vitest.e2e.config.ts",
    "test:e2e:ui": "npm run test:e2e:check && vitest --ui --config vitest.e2e.config.ts",
    "test:coverage": "vitest --run --coverage",
    "test:ui": "vitest --ui --coverage",
    "docker:e2e:build": "docker build -t flexi-day-be-e2e -f Dockerfile.e2e .",
    "docker:e2e:run": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "cross-env NODE_OPTIONS=\"--import tsx\" drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "./scripts/db-migrate.sh local",
    "db:migrate:prod": "./scripts/db-migrate.sh prod",
    "db:baseline:prod": "./scripts/db-migrate.sh prod --baseline",
    "db:status:prod": "./scripts/db-migrate.sh prod --status"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel88dev/flexi-day-be.git"
  },
  "author": "Daniel Hrynusiw",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Daniel88dev/flexi-day-be/issues"
  },
  "homepage": "https://github.com/Daniel88dev/flexi-day-be#readme",
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "better-auth": "^1.7.1",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "date-holidays": "^3.35.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "winston": "^3.18.3",
    "winston-transport": "^4.9.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/eslint-plugin-security": "^3.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^10.9.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "supertest": "^7.1.4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^14.0.0"
    },
    "esbuild": "^0.25.4",
    "brace-expansion": "^2.0.2"
  }
}
